# LOCAL demo stack config. Copy to .env.local and fill in real values:
#   cp .env.local.example .env.local
# .env.local is gitignored — never commit it. Consumed by docker-compose.local.yml
# and scripts/demo-up.sh (which auto-fills POS_PUBLIC_URL with this Mac's LAN IP).

# Postgres password for the 'pos' user; shared by the db and api containers.
DB_PASSWORD=change-me

# First portal admin, created idempotently on API boot. TOTP is enrolled at FIRST login.
ADMIN_EMAIL=owner@example.test
ADMIN_PASSWORD=replace-with-a-strong-demo-password

# Per-store bearer keys for cloud sync (/v1/ingest, revocations, heartbeat).
# STORE_API_KEY is Copper Lantern — Vieux-Port (the Android tablet);
# STORE_API_KEY_PLATEAU is Copper Lantern — Plateau (the Mac desktop store).
# scripts/demo-up.sh generates both on first run (openssl rand -hex 32).
STORE_API_KEY=replace-with-64-hex-chars
STORE_API_KEY_PLATEAU=replace-with-64-hex-chars

# Group display name (portal + TOTP issuer) and the stores' timezone (receipts + reports).
VENUE_NAME=Copper Lantern
VENUE_TZ=America/New_York

# Public base URL for scan-to-order QR codes: the Mac's LAN IP on port 8080.
# scripts/demo-up.sh OVERWRITES this with the detected IP each bring-up, so you can
# leave the placeholder — but it must be a LAN IP phones can reach, never localhost
# or a container-internal host.
POS_PUBLIC_URL=http://192.0.2.10:8080

# Local demo: skip portal MFA (TOTP). Never false on a hosted deploy.
TOTP_REQUIRED=true
