# Local two-store demo runtime (Plateau desktop store DB, logs, pid)
.demo/
__pycache__/

# Client portal instances: per-client settings + secrets (cloud/infra/new-client.sh)
cloud/infra/clients/

# AI menu photo bake-off output (scripts/image-bakeoff.py): generated images + contact sheet
.image-bakeoff/
