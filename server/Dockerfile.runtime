# Runtime-only image for the POS *store* server, built by CI
# (.github/workflows/build.yml) and pushed to ECR as pos-store:<git-sha>.
#
# Unlike server/Dockerfile — which compiles the fat jar in-image and is what the
# local demo stack builds — this COPYs a jar already built on an x64 CI runner.
# JVM bytecode is arch-independent, so only this thin runtime layer is assembled
# for linux/arm64 (the t4g box). Building moves off the production box entirely.
#
# Build context: server/  (expects build/libs/pos-server-all.jar to exist).
#
# FRENCH RECEIPTS: same font requirement as server/Dockerfile — the store draws French
# as a Java2D raster, so the runtime image must carry Noto fonts + fontconfig.
FROM eclipse-temurin:17-jre@sha256:92999aea37688157a53a40bfcb187c30f317422e028045fd5fc5c548fde9e626
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-core fontconfig curl tzdata \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --home /app --shell /usr/sbin/nologin pos
WORKDIR /app
# Context is a staged dir holding only the prebuilt jar (see build.yml) — keeps
# the context tiny and sidesteps server/.dockerignore (which excludes build/).
COPY pos-server-all.jar /app/pos-server-all.jar
RUN mkdir -p /data /data/receipts /data/bills /data/photos && chown -R pos:pos /data
USER pos
ENV TZ=America/New_York
ENV POS_XMX=512m
EXPOSE 8080
# Headless AWT so the Java2D French raster renders without an X server.
CMD exec java -Djava.awt.headless=true -Xmx${POS_XMX} -jar /app/pos-server-all.jar
