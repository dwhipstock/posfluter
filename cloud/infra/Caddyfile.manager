{
	email {$ACME_EMAIL}
}

# Portal security headers (red-team): no framing (clickjacking), no MIME
# sniffing, no full URL in the Referer. `defer` sets them after the upstream
# answers, so Next's own copies are replaced rather than doubled.
(security_headers) {
	header {
		defer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Dedicated manager/reporting portal.
{$DOMAIN}, {$LEGACY_DOMAIN} {
	encode gzip
	import security_headers

	handle /health {
		reverse_proxy api:8081
	}

	handle /v1/* {
		reverse_proxy api:8081
	}

	handle {
		reverse_proxy web:3000
	}
}

# Copper Lantern's customer/table app is deliberately an exact hostname. It
# cannot collide with the manager portal and does not introduce wildcard
# routing for unrelated venues.
{$STORE_DOMAIN} {
	encode gzip
	reverse_proxy store:8080
}
