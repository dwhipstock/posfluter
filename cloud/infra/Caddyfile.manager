{
	email {$ACME_EMAIL}
}

# Dedicated manager/reporting portal.
{$DOMAIN}, {$LEGACY_DOMAIN} {
	encode gzip

	handle /health {
		reverse_proxy api:8081
	}

	handle /v1/* {
		reverse_proxy api:8081
	}

	handle {
		reverse_proxy web:3000
	}
}

# Copper Lantern's customer/table app is deliberately an exact hostname. It
# cannot collide with the manager portal and does not introduce wildcard
# routing for unrelated venues.
{$STORE_DOMAIN} {
	encode gzip
	reverse_proxy store:8080
}
