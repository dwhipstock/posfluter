# Build context is cloud/ (see docker-compose.yml). Both stages are multi-arch.
# Base images pinned by digest (multi-arch manifest-list digest); Dependabot bumps it.
FROM gradle:8.10-jdk17@sha256:c2900027f3f0681c2cbfb09d527813851ad67aeafbb409997297efa2df20e748 AS build
WORKDIR /home/gradle/project
# --chown so the build works whether the base image runs as root or gradle.
COPY --chown=gradle:gradle api/ ./
# +x bit on the wrapper can be lost across checkouts.
RUN chmod +x gradlew && ./gradlew --no-daemon buildFatJar

FROM eclipse-temurin:17-jre@sha256:92999aea37688157a53a40bfcb187c30f317422e028045fd5fc5c548fde9e626
# curl is only for the compose healthcheck; the base image ships without it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --home /app --shell /usr/sbin/nologin api
WORKDIR /app
COPY --from=build /home/gradle/project/build/libs/api-all.jar /app/api-all.jar
COPY migrations/ /app/migrations/
USER api
EXPOSE 8081
# t4g.small has 2 GB total; cap the heap so postgres/node/caddy fit beside it.
CMD ["java", "-Xmx512m", "-jar", "/app/api-all.jar"]
