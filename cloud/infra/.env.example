# Copy to .env (same directory as docker-compose.yml) and fill in real values.
# Never commit .env.

# Public hostname the portal + API are served on; its DNS A record must point at this host.
DOMAIN=pos.example.com

# Previous hostname kept live during a manager-portal rename.
LEGACY_DOMAIN=manager.example.com

# Public hostname for this demo's customer/table app.
STORE_DOMAIN=copperlantern.example.com

# Base domain used to validate the store's public heartbeat URL.
PUBLIC_BASE_DOMAIN=example.com

# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=you@example.com

# Postgres password for the 'pos' user; the db and api containers share it.
DB_PASSWORD=change-me

# First portal admin, created idempotently on API boot; TOTP is enrolled at first login.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-too
# Keep true except on isolated demo deployments with no sensitive data.
TOTP_REQUIRED=true

# Bearer key the store uses for /v1/ingest and catalog pull. Generate with:
#   openssl rand -hex 32
STORE_API_KEY=replace-with-64-hex-chars
# More stores (one key each), and the tenant's store list (first = primary, gets STORE_API_KEY)
STORE_API_KEYS=plateau=replace-with-64-hex-chars
STORES=vieux-port=Copper Lantern — Vieux-Port,plateau=Copper Lantern — Plateau

# Display name for the venue (shown in the portal and TOTP issuer).
VENUE_NAME=Copper Lantern

# Base domain for per-venue store containers (M8): venues live at
# <slug>.BASE_DOMAIN behind one wildcard cert (Route53 DNS-01 via the
# instance profile — scripts/cloud-wildcard-setup.sh sets that up once).
BASE_DOMAIN=example.com

# Region for the Caddy route53 plugin's AWS SDK (Route 53 itself is global).
AWS_REGION=us-east-1
