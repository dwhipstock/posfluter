# The shared edge proxy (docker-compose.proxy.yml). Each client portal is one
# site file in /etc/caddy/sites, generated by new-client.sh:
#
#   <domain> {
#       /health, /v1/*  → <client-id>-api:8081
#       everything else → <client-id>-web:3000
#   }
#
# Every site is an EXACT hostname: one client's name can never route to
# another client, and an unknown hostname gets no route at all.
{
	email {$ACME_EMAIL}
}

import /etc/caddy/sites/*.caddy
